/*******************************************************
  * Name    :Service_0x28CommunicationControl
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
Return_Type Service_0x28CommunicationControl(Uds_DcmOpStatus_Type opStatus, Uds_DcmMsgContext_Type *p_msgContext, Uds_DcmNegRespCode_Type *p_errCode)
{
    Uds_CtrlType_Type ctrlType = UDS_CTR_ENABLE_RX_AND_TX;
    Uds_ComType_Type  comType  = UDS_COM_NULL_MSG;

    if (opStatus != UDS_DCM_INITIAL || RteSys_GetU32Sig(RTESYS_U32_VEHICLE_SPEED) > 3)
    {
        *p_errCode = UDS_DCM_E_NRC_CNC;
        return RET_NOT_OK;
    }

    if (p_msgContext->rxLen != 2)
    {
        *p_errCode = UDS_DCM_E_NRC_IMLOIF;
        return RET_NOT_OK;
    }

    ctrlType = (Uds_CtrlType_Type)p_msgContext->subFun;
    comType  = (Uds_ComType_Type)p_msgContext->p_rxData[1];
    if ((comType != UDS_COM_NORMAL_MSG)
        && (comType != UDS_COM_NM_MSG)
        && (comType != UDS_COM_NORMAL_MSG_AND_NM_MSG))
    {
        *p_errCode = UDS_DCM_E_NRC_ROOR;
        return RET_NOT_OK;
    }
    p_msgContext->txLen       = 1;
    p_msgContext->p_txData[0] = ctrlType;

    Service_SwtichCtlByUds(ctrlType, comType);
    return RET_OK;
}

