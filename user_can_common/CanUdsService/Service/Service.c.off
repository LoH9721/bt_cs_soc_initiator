/*******************************************************
  * Name    :Service_0x3ETesterPresent
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
Return_Type Service_0x3ETesterPresent(Uds_DcmOpStatus_Type opStatus, Uds_DcmMsgContext_Type *p_msgContext, Uds_DcmNegRespCode_Type *p_errCode)
{
    if (opStatus != UDS_DCM_INITIAL)
    {
        *p_errCode = UDS_DCM_E_NRC_CNC;
        return RET_NOT_OK;
    }

    if (p_msgContext->rxLen != 1)
    {
        *p_errCode = UDS_DCM_E_NRC_IMLOIF;
        return RET_NOT_OK;
    }

    if (p_msgContext->subFun != 0x00)
    {
        *p_errCode = UDS_DCM_E_NRC_SFNS;
        return RET_NOT_OK;
    }

    if (Service_GetCurrentSessionMode() != UDS_DCM_DEFAULT_SESSION)
    {
        Service_ResetS3ServerTime();
    }
    p_msgContext->p_txData[0] = p_msgContext->subFun;
    p_msgContext->txLen       = 1;
    return RET_OK;
}

