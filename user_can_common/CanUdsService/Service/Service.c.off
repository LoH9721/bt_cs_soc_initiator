/*******************************************************
  * Name    :Service_0x23ReadMemoryByAddress
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
Return_Type Service_0x23ReadMemoryByAddress(Uds_DcmOpStatus_Type opStatus, Uds_DcmMsgContext_Type *p_msgContext, Uds_DcmNegRespCode_Type *p_errCode)
{
    uint8_t  i          = 0;
    uint32_t memAddr    = 0;
    uint32_t memSzie    = 0;
    uint8_t  memAddrLen = 0;
    uint8_t  memSizeLen = 0;

    if (opStatus != UDS_DCM_INITIAL)
    {
        *p_errCode = UDS_DCM_E_NRC_CNC;
        return RET_NOT_OK;
    }

    if (p_msgContext->rxLen < 3)
    {
        *p_errCode = UDS_DCM_E_NRC_IMLOIF;
        return RET_NOT_OK;
    }

    if (p_msgContext->p_rxData[0] != 0x44)
    {
        *p_errCode = UDS_DCM_E_NRC_ROOR;
        return RET_NOT_OK;
    }

    memAddrLen = (uint8_t)((p_msgContext->p_rxData[1] & 0x0F) >> 0);
    memSizeLen = (uint8_t)((p_msgContext->p_rxData[1] & 0xF0) >> 4);
    if (p_msgContext->rxLen != (memAddrLen + memSizeLen + 1))
    {
        *p_errCode = UDS_DCM_E_NRC_IMLOIF;
        return RET_NOT_OK;
    }

    for (i = 0; i < memAddrLen; i++)
    {
        memAddr <<= 8;
        memAddr  |= p_msgContext->p_rxData[i + 1];
    }
    for (i = 0; i < memSizeLen; i++)
    {
        memSzie <<= 8;
        memSzie  |= p_msgContext->p_rxData[i + memAddrLen + 1];
    }
    if (memSzie > 0xFFFF)
    {
        *p_errCode = UDS_DCM_E_NRC_ROOR;
        return RET_NOT_OK;
    }

    if (Service_NvmRead(memAddr, p_msgContext->p_txData, memSzie))
    {
        *p_errCode = UDS_DCM_E_NRC_ROOR;
        return RET_NOT_OK;
    }
    p_msgContext->txLen = (uint16_t)memSzie;
    return RET_OK;
}

