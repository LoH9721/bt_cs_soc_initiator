/*******************************************************
  * Name    :Service_0x10DiagnosticSessionControl
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
Return_Type Service_0x10DiagnosticSessionControl(Uds_DcmOpStatus_Type opStatus, Uds_DcmMsgContext_Type *p_msgContext, Uds_DcmNegRespCode_Type *p_errCode)
{
    uint8_t         writeData[UDS_BOOT_LEN] = UDS_BOOT_VALID_VALUE;
    static uint32_t waitTime                = 0;

    if (opStatus == UDS_DCM_INITIAL)
    {
        if (p_msgContext->rxLen != 1)
        {
            *p_errCode = UDS_DCM_E_NRC_IMLOIF;
            return RET_NOT_OK;
        }

        if (p_msgContext->subFun != 0x02)
        {
            Service_DslSetSessionMode((Uds_DcmSessMode_Type)p_msgContext->subFun);
            p_msgContext->p_txData[0] = p_msgContext->subFun;
            p_msgContext->p_txData[1] = (uint8_t)(g_UdsGenCfg.p2ServerMax >> 8);
            p_msgContext->p_txData[2] = (uint8_t)(g_UdsGenCfg.p2ServerMax >> 0);
            p_msgContext->p_txData[3] = (uint8_t)((g_UdsGenCfg.p2StartServerMax / 10) >> 8);
            p_msgContext->p_txData[4] = (uint8_t)((g_UdsGenCfg.p2StartServerMax / 10) >> 0);
            p_msgContext->txLen       = 5;
            return RET_OK;
        }
        else if (p_msgContext->subFun == 0x02)
        {
            if (RteSys_GetU32Sig(RTESYS_U32_VEHICLE_SPEED) > 3)
            {
                *p_errCode = UDS_DCM_E_NRC_CNC;
                return RET_NOT_OK;
            }
        }
    }

    if (waitTime == 0)
    {
        if (opStatus == UDS_DCM_FORCE_RCRRP_OK)
        {
            writeData[4] = (uint8_t)p_msgContext->reqType;
            writeData[5] = UDS_DCM_SID_0X10;
            writeData[6] = p_msgContext->subFun;
            writeData[7] = p_msgContext->supPosResp;
            writeData[8] = p_msgContext->frame;
            (void)Service_NvmWrite(UDS_BOOT_VALID_ADDR, writeData, UDS_BOOT_LEN);
            waitTime = Service_GetSysTimeMs();
        }
    }
    else
    {
        if ((Service_GetSysTimeMs() - waitTime) > 200)
        {
            Service_SoftReset();
            waitTime   = 0;
            *p_errCode = UDS_DCM_E_NRC_CNC;
            return RET_NOT_OK;
        }
    }
    return RET_RCRRP;
}

/*******************************************************
  * Name    :Service_0x11EcuReset
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
Return_Type Service_0x11EcuReset(Uds_DcmOpStatus_Type opStatus, Uds_DcmMsgContext_Type *p_msgContext, Uds_DcmNegRespCode_Type *p_errCode)
{
    uint8_t         writeData[UDS_BOOT_LEN] = UDS_BOOT_VALID_VALUE;
    static uint32_t waitTime                = 0;

    if (opStatus == UDS_DCM_INITIAL)
    {
        if (p_msgContext->rxLen != 1)
        {
            *p_errCode = UDS_DCM_E_NRC_IMLOIF;
            return RET_NOT_OK;
        }
        *p_errCode = UDS_DCM_E_NRC_RCRRP;
        return RET_RCRRP;
    }

    if (waitTime == 0)
    {
        if (opStatus == UDS_DCM_FORCE_RCRRP_OK)
        {
            writeData[4] = (uint8_t)p_msgContext->reqType;
            writeData[5] = UDS_DCM_SID_0X11;
            writeData[6] = p_msgContext->subFun;
            writeData[7] = p_msgContext->supPosResp;
            writeData[8] = p_msgContext->frame;
            (void)Service_NvmWrite(UDS_BOOT_VALID_ADDR, writeData, UDS_BOOT_LEN);
            waitTime = Service_GetSysTimeMs();
        }
    }
    else
    {
        if ((Service_GetSysTimeMs() - waitTime) > 400)
        {
            Service_SoftReset();
            waitTime   = 0;
            *p_errCode = UDS_DCM_E_NRC_CNC;
            return RET_NOT_OK;
        }
    }
    return RET_RCRRP;
}

