static Uds_DslTxPdu_Type g_UdsDslTxPdu;
/*-------------function-------------------------------*/
/*******************************************************
  * Name    :Uds_TimerCtrl
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
void Uds_TimerCtrl(void)
{
    if (g_UdsTimeTick.diagActive > 0)
    {
        g_UdsTimeTick.diagActive--;
    }

    if (g_UdsTimeTick.s3Server > 0)
    {
        g_UdsTimeTick.s3Server--;
    }

    if (g_UdsTimeTick.p2Server > 0)
    {
        g_UdsTimeTick.p2Server--;
    }
    Uds_IoCtrTimerCtrl();
    Uds_SecuAccsTimerCtrl();
}

