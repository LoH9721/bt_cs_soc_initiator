/*******************************************************
  * Name    :UDS_DslNegativeResponse
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
static Bool UDS_DslNegativeResponse(Frame_Type frame, uint8_t sid, Uds_DcmNegRespCode_Type nrc)
{
    static uint8_t buffer[3] = { 0x00 };

    if ((g_UdsStatus.context.reqType == UDS_DSL_FUN_ADDR)
        && ((nrc == UDS_DCM_E_NRC_SNS)
            || (nrc == UDS_DCM_E_NRC_SFNS)
            || (nrc == UDS_DCM_E_NRC_ROOR)
            //|| (nrc == UDS_DCM_E_NRC_SFNSIAS)
            //            || (nrc == UDS_DCM_E_NRC_SNSIAS)
            ))
    {
        return TRUE;
    }

    buffer[0] = 0x7F;
    buffer[1] = sid;
    buffer[2] = nrc;
    return Uds_TxUdsTpMsg(frame, g_UdsGenCfg.diagRespId, buffer, 3);
}

/*******************************************************
  * Name    :Uds_DslPositiveResponse
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
static Bool Uds_DslPositiveResponse(Frame_Type frame, uint8_t *p_buff, uint16_t len)
{
    return Uds_TxUdsTpMsg(frame, g_UdsGenCfg.diagRespId, p_buff, len);
}

/*******************************************************
  * Name    :Uds_DcmResetToDefaultSession
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
static void Uds_DcmResetToDefaultSession(void)
{
    Uds_StopS3ServerTime();
    Uds_StopP2ServerTime();
    Uds_DtcReturnRecord();
    Uds_IoReturnControlToEcu();
    Uds_SwtichCtlByDefaultSession();
    g_UdsStatus.curSessMode = UDS_DCM_DEFAULT_SESSION;
    if (RteSys_GetU8Sig(RTESYS_U8_INTO_TEST_MODE))
    {
        RteSys_SetU8Sig(RTESYS_U8_INTO_TEST_MODE, FALSE);
    }
}

/*******************************************************
  * Name    :Uds_DslSetSessionMode
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
void Uds_DslSetSessionMode(Uds_DcmSessMode_Type sessMode)
{
    if (g_UdsStatus.curSessMode != sessMode)
    {
        g_UdsStatus.curSessMode = sessMode;
        if (g_UdsStatus.curSessMode == UDS_DCM_DEFAULT_SESSION)
        {
            Uds_DcmResetToDefaultSession();
        }
        else
        {
            Uds_ResetS3ServerTime();
        }
    }
    Uds_SetSecurityLevel(UDS_DCM_SEC_LEV_NONE);
}

/*******************************************************
  * Name    :Uds_DslDiagTimingsManager
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
static void Uds_DslDiagTimingsManager(void)
{
    if (g_UdsTimeTick.s3Server == 0)
    {
        if (g_UdsStatus.curSessMode != UDS_DCM_DEFAULT_SESSION)
        {
            Uds_DcmResetToDefaultSession();
        }
    }
}

/*******************************************************
  * Name    :Uds_DslDiagRequestCheckMsg
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
static void Uds_DslDiagRequestCheckMsg(void)
{
    if (Uds_RxUdsTpMsg(&g_UdsDslRxPdu.frame, &g_UdsDslRxPdu.id, g_UdsDslRxPdu.data, &g_UdsDslRxPdu.len) == FALSE)
    {
        return;
    }

    Uds_SetDiagRequestFlag(TRUE);
    if (g_UdsTimeTick.diagActive != 0)
    {
        return;
    }

    if ((g_UdsDslRxPdu.data[0] == 0x3E) && (g_UdsDslRxPdu.data[1] == 0x80) && (g_UdsDslRxPdu.len == 2))
    {
        Uds_ResetS3ServerTime();
        return;
    }

    if (g_UdsStatus.diagState != UDS_DSP_RESP_IDLE)
    {
        (void)UDS_DslNegativeResponse(g_UdsDslRxPdu.frame, g_UdsDslRxPdu.data[0], UDS_DCM_E_NRC_BRR);
        return;
    }
    Uds_Copy(g_UdsDslRxPdu.sdu, g_UdsDslRxPdu.data, g_UdsDslRxPdu.len);
    if (g_UdsDslRxPdu.id == g_UdsGenCfg.physAddrId)
    {
        g_UdsDslTxPdu.frame          = g_UdsDslRxPdu.frame;
        g_UdsStatus.diagState        = UDS_DSP_RESP_REQUESTED;
        g_UdsStatus.sid              = g_UdsDslRxPdu.sdu[0];
        g_UdsStatus.context.frame    = g_UdsDslRxPdu.frame;
        g_UdsStatus.context.reqType  = UDS_DSL_PHY_ADDR;
        g_UdsStatus.context.p_rxData = &g_UdsDslRxPdu.sdu[1];
        g_UdsStatus.context.rxLen    = g_UdsDslRxPdu.len - 1;
        g_UdsStatus.progConCheck     = UDS_DCM_PROG_COND_CHK_IGNORE;
        return;
    }

    if (g_UdsDslRxPdu.id == g_UdsGenCfg.funcAddrId)
    {
        g_UdsDslTxPdu.frame          = g_UdsDslRxPdu.frame;
        g_UdsStatus.diagState        = UDS_DSP_RESP_REQUESTED;
        g_UdsStatus.sid              = g_UdsDslRxPdu.sdu[0];
        g_UdsStatus.context.frame    = g_UdsDslRxPdu.frame;
        g_UdsStatus.context.reqType  = UDS_DSL_FUN_ADDR;
        g_UdsStatus.context.p_rxData = &g_UdsDslRxPdu.sdu[1];
        g_UdsStatus.context.rxLen    = g_UdsDslRxPdu.len - 1;
        g_UdsStatus.progConCheck     = UDS_DCM_PROG_COND_CHK_IGNORE;
        return;
    }
}

/*******************************************************
