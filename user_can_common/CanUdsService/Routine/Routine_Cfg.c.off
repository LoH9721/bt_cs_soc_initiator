/*******************************************************
  * Name    :Routine_0203PreProgCheck
  *******************************************************/
static Return_Type Routine_0203PreProgCheck(Uds_DcmOpStatus_Type opStatus, Routine_MsgContext_Type *p_msgContext, Uds_DcmNegRespCode_Type *p_errCode)
{
    (void)opStatus;
    (void)p_errCode;
    if (p_msgContext->ctrType == ROUTINE_CTR_START)
    {
        p_msgContext->p_txData[0] = 0x00; /* precondition OK */
        p_msgContext->txLen       = 1;
    }
    return RET_OK;
}

/*******************************************************
  * Name    :Routine_0301PhonePairing
  *******************************************************/
static Return_Type Routine_0301PhonePairing(Uds_DcmOpStatus_Type opStatus, Routine_MsgContext_Type *p_msgContext, Uds_DcmNegRespCode_Type *p_errCode)
{
    (void)opStatus;
    (void)p_errCode;
    if (p_msgContext->ctrType == ROUTINE_CTR_START)
    {
        phone_comm_switch_to_secondary();
    }
    return RET_OK;
}

