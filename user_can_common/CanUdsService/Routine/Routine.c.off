/*-------------include file---------------------------*/
#include "Routine_Cfg.h"
/*-------------variable statement---------------------*/
static uint8_t                 g_RoutineIndex;
static Routine_MsgContext_Type g_RoutineMsgContext;
static Routine_Info_Type       g_RoutineInfo[ROUTINE_CFG_LIST_NUM];
static const Routine_Ctr_Type  g_RoutineSeqTble[4][3] = {
    { ROUTINE_CTR_NONE,       ROUTINE_CTR_NONE,       ROUTINE_CTR_NONE},
    {ROUTINE_CTR_START,      ROUTINE_CTR_START,      ROUTINE_CTR_START},
    { ROUTINE_CTR_NONE,       ROUTINE_CTR_STOP,       ROUTINE_CTR_STOP},
    { ROUTINE_CTR_NONE, ROUTINE_CTR_REQ_RESULT, ROUTINE_CTR_REQ_RESULT}
};
/*-------------function-------------------------------*/
/*******************************************************
  * Name    :Routine_Init
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
void Routine_Init(void)
{
    uint8_t i = 0;

    for (i = 0; i < ROUTINE_CFG_LIST_NUM; i++)
    {
        g_RoutineInfo[i].ctrType = ROUTINE_CTR_NONE;
        g_RoutineInfo[i].opState = ROUTINE_STATE_INIT;
    }
}

/*******************************************************
  * Name    :Routine_FinalRespNrcDeal
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
static void Routine_FinalRespNrcDeal(Uds_DcmOpStatus_Type opStatus)
{
    if (opStatus == UDS_DCM_CANCEL)
    {
        g_RoutineInfo[g_RoutineIndex].ctrType = ROUTINE_CTR_NONE;
        g_RoutineInfo[g_RoutineIndex].opState = ROUTINE_STATE_STOP;
    }
}

/*******************************************************
  * Name    :Routine_RequestSequenceCheck
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
static Bool Routine_RequestSequenceCheck(Routine_Ctr_Type ctrlType, Routine_State_Type opState)
{
    return (ctrlType != g_RoutineSeqTble[(uint8_t)ctrlType][(uint8_t)opState]) ? FALSE : TRUE;
}

/*******************************************************
  * Name    :Routine_0x31RoutineControl
  * Author  :WangHu
  * Function:****
  * Version :V1.0.0
  * Data    :2024.1.2
*******************************************************/
Return_Type Routine_0x31RoutineControl(Uds_DcmOpStatus_Type opStatus, Uds_DcmMsgContext_Type *p_msgContext, Uds_DcmNegRespCode_Type *p_errCode)
{
    uint8_t          i       = 0;
    uint8_t          len     = 0;
    uint16_t         id      = 0;
    Return_Type      ret     = RET_NOT_OK;
    Routine_Ctr_Type ctrType = ROUTINE_CTR_NONE;

    if (opStatus == UDS_DCM_INITIAL)
    {
        if (p_msgContext->rxLen < 3)
        {
            *p_errCode = UDS_DCM_E_NRC_IMLOIF;
            return RET_NOT_OK;
        }

        ctrType  = (Routine_Ctr_Type)p_msgContext->p_rxData[0];
        id       = (uint16_t)(p_msgContext->p_rxData[1] << 8);
        id      += (uint16_t)(p_msgContext->p_rxData[2] << 0);
        for (i = 0; i < ROUTINE_CFG_LIST_NUM; i++)
        {
            if (id == g_RoutineCfgList[i].id)
            {
                break;
            }
        }
        if (i >= ROUTINE_CFG_LIST_NUM)
        {
            *p_errCode = UDS_DCM_E_NRC_ROOR;
            return RET_NOT_OK;
        }

        if (((1 << Routine_GetCurrentSessionMode()) & g_RoutineCfgList[i].supSessMode) == FALSE)
        {
            *p_errCode = UDS_DCM_E_NRC_ROOR;
            return RET_NOT_OK;
        }

        if (Routine_GetCurrentSecurityLevel() < g_RoutineCfgList[i].secuAccsLvl)
        {
            *p_errCode = UDS_DCM_E_NRC_SAD;
            return RET_NOT_OK;
        }

        if ((ctrType != ROUTINE_CTR_START)
            && ((ctrType != ROUTINE_CTR_STOP) || (g_RoutineCfgList[i].supStop == FALSE))
            && ((ctrType != ROUTINE_CTR_REQ_RESULT) || (g_RoutineCfgList[i].supReqResult == FALSE)))
        {
            *p_errCode = UDS_DCM_E_NRC_SFNS;
            return RET_NOT_OK;
        }

        if (ctrType == ROUTINE_CTR_START)
        {
            len += g_RoutineCfgList[i].len + 3;
        }
        else
        {
            len = 3;
        }

        if (len != p_msgContext->rxLen)
        {
            *p_errCode = UDS_DCM_E_NRC_IMLOIF;
            return RET_NOT_OK;
        }

        if (Routine_CheckIfService0x31ConditionsNotCorrect(id) == TRUE)
        {
            *p_errCode = UDS_DCM_E_NRC_CNC;
            return RET_NOT_OK;
        }

        if (Routine_RequestSequenceCheck(ctrType, g_RoutineInfo[i].opState) == FALSE)
        {
            *p_errCode = UDS_DCM_E_NRC_RSE;
            return RET_NOT_OK;
        }

        if (ctrType == ROUTINE_CTR_START)
        {
            g_RoutineInfo[i].opState = ROUTINE_STATE_RUN;
        }
        g_RoutineIndex                  = i;
        g_RoutineInfo[i].ctrType        = ctrType;
        p_msgContext->finalRespNrc      = UDS_DCM_E_NRC_GPF;
        p_msgContext->finalRespToNotify = Routine_FinalRespNrcDeal;
        g_RoutineMsgContext.ctrType     = ctrType;
        g_RoutineMsgContext.rxLen       = p_msgContext->rxLen - 3;
        g_RoutineMsgContext.txLen       = 0;
        g_RoutineMsgContext.p_rxData    = &p_msgContext->p_rxData[3];
        g_RoutineMsgContext.p_txData    = &p_msgContext->p_txData[3];
    }
    ret = g_RoutineCfgList[g_RoutineIndex].dataHandleFun(opStatus, &g_RoutineMsgContext, p_errCode);
    if (ret == RET_OK)
    {
        p_msgContext->p_txData[0] = p_msgContext->p_rxData[0];
        p_msgContext->p_txData[1] = p_msgContext->p_rxData[1];
        p_msgContext->p_txData[2] = p_msgContext->p_rxData[2];
        p_msgContext->txLen       = g_RoutineMsgContext.txLen + 3;
        if ((g_RoutineInfo[g_RoutineIndex].ctrType != ROUTINE_CTR_START) || (g_RoutineCfgList[g_RoutineIndex].exeWay == ROUTINE_EXE_DIRECT))
        {
            g_RoutineInfo[i].opState = ROUTINE_STATE_STOP;
        }
    }
    return ret;
}

